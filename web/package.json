{
	"name": "battleship-web",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/app/battleship.tsx"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"engine": "cd .. && ./gradlew generateJavaScript",
		"dev": "vite",
		"build": "vite build && node scripts/check-bundle.ts",
		"preview": "vite preview",
		"lint": "eslint . && prettier --check . && node scripts/check-no-javascript.ts",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource/roboto": "5.3.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-error-boundary": "6.1.6",
		"zod": "4.6.7",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.0",
		"@rolldown/plugin-babel": "0.2.4",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-check-file": "3.3.2",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsx-a11y-x": "0.2.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"jiti": "2.7.0",
		"jsdom": "30.1.2",
		"prettier": "3.9.10",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	}
}
